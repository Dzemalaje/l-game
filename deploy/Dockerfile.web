# syntax=docker/dockerfile:1
#
# The static Expo web export, served by Caddy.
#
# Expo inlines every EXPO_PUBLIC_* value into the JavaScript bundle at build time, so the address of
# the SpacetimeDB server is fixed *here*, not at container start. Changing it means rebuilding the
# image, which is exactly what a Dokploy redeploy does.

FROM node:22-bookworm-slim AS build
WORKDIR /app

# Dependencies come from the lockfile in their own layer, so editing source does not reinstall them.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG EXPO_PUBLIC_SPACETIMEDB_URL
ARG EXPO_PUBLIC_SPACETIMEDB_NAME=l-game
ARG EXPO_PUBLIC_LEGAL_OPERATOR
ARG EXPO_PUBLIC_LEGAL_CONTACT

# Without this the client falls back to wss://<the web host>:3000, which is not published and fails
# at the first connection - a broken deploy that only shows up when a player tries to play online.
RUN test -n "$EXPO_PUBLIC_SPACETIMEDB_URL" \
  || (echo "EXPO_PUBLIC_SPACETIMEDB_URL build arg is required (e.g. wss://stdb.example.com)" >&2; exit 1)

ENV EXPO_PUBLIC_SPACETIMEDB_URL=${EXPO_PUBLIC_SPACETIMEDB_URL} \
    EXPO_PUBLIC_SPACETIMEDB_NAME=${EXPO_PUBLIC_SPACETIMEDB_NAME} \
    EXPO_PUBLIC_LEGAL_OPERATOR=${EXPO_PUBLIC_LEGAL_OPERATOR} \
    EXPO_PUBLIC_LEGAL_CONTACT=${EXPO_PUBLIC_LEGAL_CONTACT}

RUN npm run build:web

FROM caddy:2.10-alpine AS runtime
COPY deploy/Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/index.html >/dev/null || exit 1
