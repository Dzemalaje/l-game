{
  "name": "the-l-game",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env LGAME_PLATFORM=web expo start --web",
    "dev": "concurrently -n expo,spacetimedb -c green,blue \"cross-env LGAME_PLATFORM=web expo start --web\" \"npm run stdb:start\"",
    "dev:client": "cross-env LGAME_PLATFORM=web expo start --web",
    "web": "cross-env LGAME_PLATFORM=web expo start --web",
    "native": "cross-env LGAME_PLATFORM=native expo start",
    "android": "cross-env LGAME_PLATFORM=native expo start --android",
    "ios": "cross-env LGAME_PLATFORM=native expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "stdb:start": "spacetime start --listen-addr 127.0.0.1:3000",
    "stdb:build": "spacetime build -p spacetimedb/spacetimedb",
    "stdb:publish": "spacetime publish l-game --server local -p spacetimedb/spacetimedb --yes",
    "stdb:reset": "spacetime publish l-game --server local -p spacetimedb/spacetimedb --delete-data=always --yes",
    "stdb:generate": "spacetime generate --lang typescript --module-path spacetimedb/spacetimedb --out-dir src/module_bindings",
    "stdb:play": "node spacetimedb/play/serve.mjs",
    "stdb:logs": "spacetime logs l-game --server local -f",
    "stdb:sql": "spacetime sql l-game --server local --interactive",
    "test:stdb": "tsx --test spacetimedb/test/rules.test.ts",
    "test:stdb:e2e": "tsx spacetimedb/test/e2e.ts",
    "test:stdb:play": "node spacetimedb/play/smoke.mjs",
    "smoke:online": "node --env-file-if-exists=.env.local tools/smoke-online-stdb.mjs",
    "build:web": "cross-env LGAME_PLATFORM=web expo export --platform web",
    "build": "npm run build:web",
    "test": "tsx --test src/shared/rules.test.ts src/game/net.test.ts",
    "smoke:browser": "node tools/smoke-expo-web.mjs",
    "bench": "tsx tools/bench-rules.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:stdb && npm run build && npm run smoke:browser",
    "check:full": "npm run check && npm run test:stdb:e2e && npm run smoke:online"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "spacetimedb": "2.8.*",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.18",
    "concurrently": "10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.8.2",
    "tsx": "4.23.12",
    "typescript": "~6.0.3"
  }
}
