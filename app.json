{
  "expo": {
    "name": "The L Game",
    "slug": "the-l-game",
    "version": "1.0.0",
    "icon": "./public/icons/icon-512.png",
    "orientation": "portrait",
    "scheme": "the-l-game",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lgame.app"
    },
    "android": {
      "package": "com.lgame.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/maskable-512.png",
        "backgroundColor": "#F4F0E6"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
