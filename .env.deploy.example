# Values Dokploy needs in Settings -> Environment for the Compose deployment.
# Copy into the Dokploy environment editor, not into the repository.

# The two hostnames, each needing an A record pointed at the VPS.
APP_DOMAIN=lgame.example.com
STDB_DOMAIN=stdb.example.com

# Shown on the in-game Terms and Privacy pages. Required before a public release.
EXPO_PUBLIC_LEGAL_OPERATOR=Your legal name or company
EXPO_PUBLIC_LEGAL_CONTACT=privacy@example.com

# The database name inside SpacetimeDB. Changing it after the first deploy creates a second, empty
# database rather than renaming the first.
SPACETIMEDB_NAME=l-game

# Pin the server and CLI together. Both come from the same image tag.
SPACETIME_VERSION=v2.8.1

# The identity allowed to update the database. Leave blank on the very first deploy, then read it
# out of the running stack and paste it here - see docs/DEPLOYMENT.md.
SPACETIMEDB_TOKEN=
