# Browser connection to SpacetimeDB. Local defaults are shown here; use wss:// behind TLS.
EXPO_PUBLIC_SPACETIMEDB_URL=ws://127.0.0.1:3000
EXPO_PUBLIC_SPACETIMEDB_NAME=l-game

# Required before a public release. These values are shown in the in-game Terms and Privacy pages.
EXPO_PUBLIC_LEGAL_OPERATOR=Your legal name or company
EXPO_PUBLIC_LEGAL_CONTACT=privacy@example.com

# No application database variables are used. Accounts, ratings, matches, friends and the
# leaderboard all live in the SpacetimeDB module under spacetimedb/ - it is both the database and
# the game server, so there is no separate DB to configure.
